runSemaTestsImpl(testDir: String): Bool {
    var listing3: List = nx_list_dir(testDir)
    var allPass3: Bool = true
    var i3: Int = 0
    while (i3 < listing3.len()) {
        var name3: String = listing3.get(i3)
        if (name3.endsWith(".nx")) {
            var nxPath3 = testDir + "/" + name3
            var isInvalid = name3.startsWith("invalid_")
            var src3 = io.readFile(nxPath3)
            var tokens3 = tokenizeSource(src3)
            var prog3 = parseSource(tokens3)
            var ctx3 = checkProgram(prog3)
            if (ctx3.errors.len() > 0) {
                if (isInvalid) {
                    io.println("PASS sema (invalid): " + nxPath3)
                } else {
                    io.println("FAIL sema: " + nxPath3)
                    allPass3 = false
                }
            } else {
                if (isInvalid) {
                    io.println("FAIL sema (invalid, esperaba error): " + nxPath3)
                    allPass3 = false
                } else {
                    io.println("PASS sema: " + nxPath3)
                }
            }
        }
        i3 = i3 + 1
    }
    return allPass3
}
