{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nexus",
  "scopeName": "source.nexus",
  "patterns": [
    { "include": "#comments" },
    { "include": "#raw-strings" },
    { "include": "#multiline-strings" },
    { "include": "#strings" },
    { "include": "#char-literals" },
    { "include": "#imports" },
    { "include": "#keywords" },
    { "include": "#builtin-types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#extension-definition" },
    { "include": "#function-definition" },
    { "include": "#class-definition" },
    { "include": "#method-call" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.nexus",
          "match": "//.*$"
        },
        {
          "name": "comment.block.nexus",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.nexus" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.nexus" } }
        }
      ]
    },
    "raw-strings": {
      "name": "string.quoted.double.raw.nexus",
      "begin": "r\"",
      "end": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.nexus" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.nexus" } }
    },
    "multiline-strings": {
      "name": "string.quoted.triple.nexus",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.nexus" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.nexus" } }
    },
    "strings": {
      "name": "string.quoted.double.nexus",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.nexus" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.nexus" } },
      "patterns": [
        {
          "name": "constant.character.escape.nexus",
          "match": "\\\\[ntr\\\\\"0]"
        }
      ]
    },
    "char-literals": {
      "name": "string.quoted.single.nexus",
      "match": "'(?:\\\\[ntr\\\\'0]|[^'\\\\])'",
      "captures": {
        "0": { "name": "string.quoted.single.nexus" }
      }
    },
    "imports": {
      "name": "meta.import.nexus",
      "begin": "\\bimport\\b",
      "beginCaptures": { "0": { "name": "keyword.other.import.nexus" } },
      "end": "(?=;|$)",
      "patterns": [
        {
          "name": "keyword.other.import.alias.nexus",
          "match": "\\bas\\b"
        },
        {
          "name": "keyword.other.import.wildcard.nexus",
          "match": "\\.\\*"
        },
        {
          "name": "punctuation.separator.import.group.nexus",
          "match": "[{}]"
        },
        {
          "name": "entity.name.namespace.nexus",
          "match": "[a-zA-Z_][a-zA-Z0-9_.]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nexus",
          "match": "\\b(if|else|while|for|in|return|break|continue|try|catch|throw|switch|case|default)\\b"
        },
        {
          "name": "keyword.declaration.nexus",
          "match": "\\b(var|val|final|fun|class|data|value|interface|annotation)\\b"
        },
        {
          "name": "keyword.other.nexus",
          "match": "\\b(import|module|extends|implements|this)\\b"
        }
      ]
    },
    "builtin-types": {
      "name": "storage.type.nexus",
      "match": "\\b(Int|Long|Float|Double|Bool|Char|String|Void|List|Map)\\b"
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.nexus",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.nexus",
          "match": "\\bnull\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.nexus",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.nexus",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "extension-definition": {
      "match": "^\\s*fun\\s+([A-Z][a-zA-Z0-9_]*)\\.([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.type.nexus" },
        "2": { "name": "entity.name.function.nexus" }
      }
    },
    "function-definition": {
      "comment": "Top-level function: name( at statement start, not fun Type.method(",
      "match": "^\\s*(?!(?:fun\\s+[A-Z][a-zA-Z0-9_]*\\.))([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.nexus" }
      }
    },
    "class-definition": {
      "patterns": [
        {
          "match": "\\b(class|data|value|interface|annotation)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.nexus" },
            "2": { "name": "entity.name.type.nexus" }
          }
        },
        {
          "name": "entity.name.type.nexus",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "method-call": {
      "match": "\\.([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.member.nexus" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.nexus",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.comparison.nexus",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.nexus",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.nexus",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.arrow.nexus",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.nullable.nexus",
          "match": "\\?\\.|\\?:|\\?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.colon.nexus",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.nexus",
          "match": ","
        },
        {
          "name": "punctuation.terminator.nexus",
          "match": ";"
        }
      ]
    }
  }
}