makeRange(startLine: Int, startCol: Int, endLine: Int, endCol: Int): JSONValue {
    var keys: List = List()
    keys.push("start")
    keys.push("end")
    var vals: List = List()
    vals.push(makePosition(startLine, startCol))
    vals.push(makePosition(endLine, endCol))
    return makeJsonObjectFromPairs(keys, vals)
}

