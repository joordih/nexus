makeJsonObjectFromPairs(keys: List, values: List): JSONValue {
    var m: Map = Map()
    var i = 0
    while (i < keys.len()) {
        var k: String = keys.get(i)
        var v: JSONValue = values.get(i)
        m.put(k, v)
        i = i + 1
    }
    return makeJsonObject(m)
}

jsonRpcResult(idVal: JSONValue, result: JSONValue): JSONValue {
    var keys: List = List()
    keys.push("jsonrpc")
    keys.push("id")
    keys.push("result")
    var vals: List = List()
    vals.push(makeJsonString("2.0"))
    vals.push(idVal)
    vals.push(result)
    return makeJsonObjectFromPairs(keys, vals)
}

jsonRpcError(idVal: JSONValue, code: Int, message: String): JSONValue {
    var errKeys: List = List()
    errKeys.push("code")
    errKeys.push("message")
    var errVals: List = List()
    errVals.push(makeJsonInt(code))
    errVals.push(makeJsonString(message))
    var errObj = makeJsonObjectFromPairs(errKeys, errVals)
    var keys: List = List()
    keys.push("jsonrpc")
    keys.push("id")
    keys.push("error")
    var vals: List = List()
    vals.push(makeJsonString("2.0"))
    vals.push(idVal)
    vals.push(errObj)
    return makeJsonObjectFromPairs(keys, vals)
}

