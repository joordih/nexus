import std.io
import std.json
import std.fs.path
import std.network.http_client as http

greeting(): String {
    return "Hello, Nexus!"
}

roundTripJson(): String {
    val document = json.parse("{\"msg\":\"hello\"}")
    return json.stringify(document)
}

scriptLocation(): String {
    return path.joinPath("examples", "hello.nx")
}

sampleHttpRequest(): String {
    return http.buildHttpGetRequest("example.com", "/")
}

main(): Void {
    io.println(greeting())
    io.println(roundTripJson())
    io.println(scriptLocation())
    io.println(sampleHttpRequest())
}