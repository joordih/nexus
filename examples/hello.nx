import std.io
import std.json
import std.fs.path
import std.network.http_client

main(): Void {
    io.println("Hola, Nexus!")
    val doc = json.parse("{\"msg\":\"hola\"}")
    io.println(json.stringify(doc))
    val scriptPath = path.joinPath("examples", "hello.nx")
    io.println(scriptPath)
    val request = http_client.buildHttpGetRequest("example.com", "/")
    io.println(request)
}