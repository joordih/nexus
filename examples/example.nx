import std.io

data Punto {
    x: Int
    y: Int
    label: String?
}

class PuntoService {
    distanciaOrigenCuadrado(p: Punto): Int {
        return p.x * p.x + p.y * p.y
    }
}

areaAproximada(radio: Int): Int {
    return 3 * radio * radio
}

main(): Void {
    val origen = Punto(x: 3, y: 4, label: null)
    val marcado = Punto(x: 1, y: 1, label: "A")
    val svc = PuntoService()
    io.println(svc.distanciaOrigenCuadrado(origen))
    io.println(areaAproximada(5))
    io.println(origen.label ?: "sin etiqueta")
    io.println(marcado.label ?: "sin etiqueta")
}