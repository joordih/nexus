import std.io
import std.json
import std.core.{integer, math, string_builder, strings}
import std.collections.{array_list, linked_hash_map, optional, stack, tree_set}
import std.fs.{files, path}
import std.system.{environment, runtime_info}
import std.network.http_client
import std.datetime.{duration, local_date}
import std.regex.matcher

final CHECK_PREFIX: String = "check"

logCheck(name: String, value: String): Void {
    io.println(CHECK_PREFIX + " " + name + ": " + value)
}

logCheckBool(name: String, value: Bool): Void {
    if (value) {
        logCheck(name, "true")
    } else {
        logCheck(name, "false")
    }
}

demoJson(): Void {
    val document = json.parse("{\"name\":\"nexus\",\"version\":1}")
    logCheck("json_roundtrip", json.stringify(document))
}

demoCore(): Void {
    logCheck("math_abs", integer.formatInt(math.absInt(-42)))
    logCheck("strings_trim", strings.trimString("  stdlib  "))
    val builder = StringBuilder(parts: List())
    builder.append("nex")
    builder.append("us")
    logCheck("string_builder", builder.toString())
}

demoCollections(): Void {
    val list = ArrayList(elems: List())
    list.add("alpha")
    list.add("beta")
    logCheck("array_list_size", integer.formatInt(list.size()))

    val stack = Stack(elems: List(), count: 0)
    stack.push("one")
    stack.push("two")
    logCheck("stack_top", stack.peek())

    val ordered = LinkedHashMap(order: List(), entries: Map())
    ordered.put("first", "one")
    ordered.put("second", "two")
    logCheck("linked_hash_order", ordered.keyAt(0))
    logCheck("linked_hash_get", ordered.get("second")!)

    val sorted = TreeSet(sortedKeys: List(), members: Map())
    sorted.add("cherry")
    sorted.add("apple")
    sorted.add("banana")
    logCheck("tree_set_first", sorted.keyAt(0))

    val maybe = optionalOf("ready")
    logCheck("optional_value", maybe.orElse("missing"))
}

demoFilesystem(): Void {
    val joined = path.joinPath("examples", "hello.nx")
    logCheck("path_join", joined)
    logCheckBool("files_exists", files.exists(joined))
}

demoDatetime(): Void {
    logCheck("epoch_date", local_date.localDateFromEpoch(0).toString())
    logCheck("duration_secs", integer.formatInt(duration.durationSeconds(120).toSeconds()))
}

demoRegex(): Void {
    val pattern = matcher.compilePattern("N.xus")
    logCheckBool("regex_match", matcher.matchPattern(pattern, "Nexus"))
}

demoEnvironment(): Void {
    logCheckBool("env_path_set", nx_string_len(getEnv("PATH")) > 0)
}

demoNetwork(): Void {
    val request = http_client.buildHttpGetRequest("example.com", "/")
    logCheckBool("http_has_host", nx_string_contains(request, "Host: example.com"))
}

demoExceptionHandling(): Void {
    var caught = false
    try {
        throw
    } catch (err) {
        caught = true
    }
    logCheckBool("try_catch", caught)
}

demoRuntime(): Void {
    logCheckBool("runtime_epoch_positive", runtime_info.epochSeconds() > 0)
}

main(): Void {
    demoJson()
    demoCore()
    demoCollections()
    demoFilesystem()
    demoDatetime()
    demoRegex()
    demoEnvironment()
    demoNetwork()
    demoExceptionHandling()
    demoRuntime()
    io.println("stdlib showcase complete")
}