import std.io

fibonacci(n: Int): Int {
    if (n <= 1) {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

formatFibonacciResult(n: Int, result: Int): String {
    return "fib(" + n.toString() + ") = " + result.toString()
}

main(): Void {
    val n = 10
    io.println(formatFibonacciResult(n, fibonacci(n)))
}